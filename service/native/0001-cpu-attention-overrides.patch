+ggml_tensor * llm_graph_context::ctx_attention_mask(
+        ggml_tensor * native, const ggml_tensor * key_indices, int layer, int heads) const {
+    if (!attention || !attention->n_rules) {
+        return native;
+    }
+    if (!native || native->type != GGML_TYPE_F32 || native->ne[1] != n_tokens ||
+            native->ne[2] != 1 || native->ne[3] != 1 || heads < 1 || heads > 64 || layer < 0 || layer >= 64) {
+        throw llama_attention_error{"Unsupported attention mask shape"};
+    }
+
+    std::vector<std::vector<size_t>> selected(heads);
+    bool any = false;
+    for (size_t i = 0; i < attention->n_rules; ++i) {
+        const auto & rule = attention->rules[i];
+        if (!(rule.layers & (uint64_t{1} << layer))) {
+            continue;
+        }
+        for (int h = 0; h < heads; ++h) {
+            if (rule.heads & (uint64_t{1} << h)) {
+                selected[h].push_back(i);
+                any = true;
+            }
+        }
+    }
+    if (!any) {
+        return native;
+    }
+    if (std::all_of(selected.begin() + 1, selected.end(), [&](const auto & h) { return h == selected.front(); })) {
+        selected.resize(1);
+    }
+    for (const auto * mask : attention_masks) {
+        if (mask->native == native && mask->key_indices == key_indices && mask->selected == selected) {
+            return mask->effective;
+        }
+    }
+
+    attention_mask_bytes += ggml_nbytes(native) * selected.size();
+    if (attention_mask_bytes > 256 * 1024 * 1024) {
+        throw llama_attention_error{"Padded attention masks exceed the 256 MiB limit"};
+    }
+    for (const auto & head_rules : selected) {
+        for (size_t i : head_rules) {
+            const auto & r = attention->rules[i];
+            uint64_t queries = 0;
+            uint64_t keys = 0;
+            for (size_t q = 0; q < r.n_queries; ++q) {
+                queries += r.queries[q].end - r.queries[q].start;
+            }
+            for (size_t k = 0; k < r.n_keys; ++k) {
+                keys += r.keys[k].end - r.keys[k].start;
+            }
+            attention_mask_writes += queries * keys;
+            if (attention_mask_writes > 256 * 1024 * 1024) {
+                throw llama_attention_error{"Attention rule coverage exceeds the edit limit"};
+            }
+        }
+    }
+    // Retain the native input even when every layer uses an override.
+    ggml_build_forward_expand(gf, native);
+    auto * effective = ggml_new_tensor_4d(ctx0, GGML_TYPE_F32, native->ne[0], n_tokens, selected.size(), 1);
+    ggml_set_input(effective);
+    cb(effective, "local_kq_mask", layer);
+    auto input = std::make_unique<llm_graph_input_attention_override>(*attention, native, key_indices, std::move(selected), effective);
+    attention_masks.push_back(input.get());
+    res->add_input(std::move(input));
+    return effective;
+}
