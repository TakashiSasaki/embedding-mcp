+// The stock input writes the native plane first. Copy it per distinct head
+// selection, then edit only the cells for keys owned by this complete sequence.
+class llm_graph_input_attention_override : public llm_graph_input_i {
+public:
+    const llama_attention_request & request;
+    const ggml_tensor * native;
+    const ggml_tensor * key_indices;
+    std::vector<std::vector<size_t>> selected;
+    ggml_tensor * effective;
+
+    llm_graph_input_attention_override(const llama_attention_request & request, const ggml_tensor * native,
+            const ggml_tensor * key_indices, std::vector<std::vector<size_t>> selected, ggml_tensor * effective)
+        : request(request), native(native), key_indices(key_indices), selected(std::move(selected)), effective(effective) {}
+
+    void set_input(const llama_ubatch * ubatch) override {
+        if (!native->buffer || !ggml_backend_buffer_is_host(native->buffer) ||
+                !ggml_backend_buffer_is_host(effective->buffer) ||
+                (key_indices && (!key_indices->buffer || !ggml_backend_buffer_is_host(key_indices->buffer)))) {
+            throw llama_attention_error{"Attention overrides require host mask and key tensors"};
+        }
+
+        const size_t n_keys = native->ne[0];
+        const size_t n_queries = ubatch->n_tokens;
+        const auto * kv_indices = key_indices ? static_cast<const int64_t *>(key_indices->data) : nullptr;
+        std::vector<size_t> keys(n_queries);
+        std::vector<bool> occupied(n_keys);
+        for (size_t i = 0; i < n_queries; ++i) {
+            const auto index = kv_indices ? kv_indices[i] : int64_t(i);
+            if (index < 0 || uint64_t(index) >= n_keys || occupied[index]) {
+                throw llama_attention_error{"Invalid key placement for the complete sequence"};
+            }
+            keys[i] = index;
+            occupied[index] = true;
+        }
+
+        const auto * original = static_cast<const float *>(native->data);
+        auto * plane = static_cast<float *>(effective->data);
+        for (const auto & head_rules : selected) {
+            std::copy_n(original, n_queries * n_keys, plane);
+            for (size_t rule_index : head_rules) {
+                const auto & rule = request.rules[rule_index];
+                for (size_t q = 0; q < rule.n_queries; ++q) {
+                    for (int query = rule.queries[q].start; query < rule.queries[q].end; ++query) {
+                        auto * row = plane + query * n_keys;
+                        for (size_t k = 0; k < rule.n_keys; ++k) {
+                            for (int key = rule.keys[k].start; key < rule.keys[k].end; ++key) {
+                                auto & cell = row[keys[key]];
+                                if (!rule.allow) {
+                                    cell = -INFINITY;
+                                } else if (cell == -INFINITY) {
+                                    cell = 0.0f;
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+            for (size_t query = 0; query < n_queries; ++query) {
+                const auto * row = plane + query * n_keys;
+                if (std::none_of(keys.begin(), keys.end(), [&](size_t key) { return std::isfinite(row[key]); })) {
+                    throw llama_attention_error{"An attention rule leaves a query with no visible key"};
+                }
+            }
+            plane += n_queries * n_keys;
+        }
+    }
+};
