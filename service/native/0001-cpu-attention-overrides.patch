+int llama_context::decode_with_attention(const llama_batch_ext & batch, llama_attention_request & request) {
+    if (cparams.flash_attn || cparams.pipeline_parallel || !cparams.embeddings || model.hparams.use_alibi ||
+            (model.arch != LLM_ARCH_BERT && model.arch != LLM_ARCH_QWEN3 && model.arch != LLM_ARCH_GEMMA_EMBEDDING2)) {
+        request.error = "Attention overrides require a supported CPU embedding model with flash attention disabled";
+        return -1;
+    }
+    if (attention || batch.tokens.empty() || batch.tokens.size() > cparams.n_ubatch || request.n_rules > 64 || request.n_probes > 16) {
+        request.error = "Invalid attention request size";
+        return -1;
+    }
+    const auto & seq_ids = batch.tokens.front().seq_ids;
+    const auto max_seq = cparams.kv_unified ? LLAMA_MAX_SEQ : cparams.n_seq_max;
+    if (seq_ids.size() != 1 || seq_ids.front() < 0 || uint32_t(seq_ids.front()) >= max_seq ||
+            (memory && memory->seq_pos_max(seq_ids.front()) >= 0)) {
+        request.error = "Attention overrides require one sequence with an empty cache";
+        return -1;
+    }
+    request.n_tokens = batch.tokens.size();
+    const int layers = model.hparams.n_layer();
+    const int heads = model.hparams.n_head();
+    if (layers < 1 || layers > 64 || heads < 1 || heads > 64) {
+        request.error = "Unsupported layer or query head count";
+        return -1;
+    }
+    const auto valid_ranges = [&](const llama_attention_span * spans, size_t n) {
+        if (!spans || !n || n > request.n_tokens) {
+            return false;
+        }
+        int end = 0;
+        for (size_t i = 0; i < n; ++i) {
+            if (spans[i].start < end || spans[i].end <= spans[i].start || uint64_t(spans[i].end) > request.n_tokens) {
+                return false;
+            }
+            end = spans[i].end;
+        }
+        return true;
+    };
+    for (size_t i = 0; i < request.n_rules; ++i) {
+        const auto & r = request.rules[i];
+        if (!r.layers || (layers < 64 && r.layers >> layers) || !r.heads || (heads < 64 && r.heads >> heads) ||
+                !valid_ranges(r.queries, r.n_queries) || !valid_ranges(r.keys, r.n_keys)) {
+            request.error = "Invalid attention rule coordinates";
+            return -1;
+        }
+    }
+    for (size_t i = 0; i < request.n_probes; ++i) {
+        const auto & p = request.probes[i];
+        if (p.layer < 0 || p.layer >= layers || p.head < 0 || p.head >= heads || p.query < 0 || p.key < 0 ||
+                uint64_t(p.query) >= request.n_tokens || uint64_t(p.key) >= request.n_tokens) {
+            request.error = "Invalid attention probe coordinates";
+            return -1;
+        }
+    }
+
+    // Reserve the ordinary graph before setting the request pointer. Its reserve
+    // batches may have a different sequence count and token positions.
+    sched_reserve();
+    attention = &request;
+    const auto reset = [&]() {
+        attention = nullptr;
+        gf_res_prev_active = nullptr;
+        ggml_backend_sched_set_eval_callback(sched.get(), cparams.cb_eval, cparams.cb_eval_user_data);
+    };
+    try {
+        const int ret = decode(batch);
+        synchronize();
+        reset();
+        return ret;
+    } catch (...) {
+        reset();
+        throw;
+    }
+}
+
+int32_t llama_process_with_attention(
+        llama_context * ctx, llama_batch_ext * batch,
+        const llama_attention_rule * rules, size_t n_rules,
+        llama_attention_probe * probes, size_t n_probes, const char ** error) {
+    llama_attention_request request{rules, n_rules, probes, n_probes, 0, nullptr, {}};
+    const int32_t ret = ctx->decode_with_attention(*batch, request);
+    if (error) {
+        *error = request.error;
+    }
+    return ret;
+}
