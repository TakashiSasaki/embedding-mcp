+static bool local_attention_eval(ggml_tensor * tensor, bool ask, void * user_data) {
+    auto & request = *static_cast<llama_attention_request *>(user_data);
+    const auto it = std::find_if(request.captures.begin(), request.captures.end(),
+                                [tensor](const auto & c) { return c.probabilities == tensor; });
+    if (ask || it == request.captures.end()) {
+        return it != request.captures.end();
+    }
+    for (size_t i = 0; i < request.n_probes; ++i) {
+        auto & p = request.probes[i];
+        if (p.layer != it->layer) {
+            continue;
+        }
+        int64_t key = p.key;
+        if (it->key_indices) {
+            ggml_backend_tensor_get(it->key_indices, &key, p.key * sizeof(key), sizeof(key));
+        }
+        const size_t head = it->mask->ne[2] == 1 ? 0 : p.head;
+        float value;
+        ggml_backend_tensor_get(it->mask, &value, key * it->mask->nb[0] + p.query * it->mask->nb[1] +
+                                head * it->mask->nb[2], sizeof(value));
+        ggml_backend_tensor_get(tensor, &p.probability, key * tensor->nb[0] + p.query * tensor->nb[1] +
+                                p.head * tensor->nb[2], sizeof(p.probability));
+        p.allowed = std::isfinite(value);
+        p.observed = true;
+    }
+    return true;
+}
