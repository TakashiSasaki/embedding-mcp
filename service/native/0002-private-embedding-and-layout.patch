--- /dev/null
+++ b/tools/server/server-embedding-local.cpp
@@ -0,0 +1,252 @@
+#include "server-embedding-local.h"
+
+#include "hash/hash.h"
+
+#include <algorithm>
+#include <cmath>
+#include <stdexcept>
+
+namespace {
+
+struct input_group {
+    std::string type;
+    std::string text;
+    std::vector<int> parts;
+    const mtmd_bitmap * bitmap = nullptr;
+};
+
+bool control_token(const llama_vocab * vocab, llama_token token) {
+    return llama_vocab_is_control(vocab, token) || token == llama_vocab_bos(vocab) ||
+           token == llama_vocab_eos(vocab) || token == llama_vocab_sep(vocab);
+}
+
+void add_span(json & spans, size_t start, size_t end, const std::string & modality, const std::vector<int> & parts) {
+    if (start == end) {
+        return;
+    }
+    if (!spans.empty() && spans.back()["modality"] == modality && spans.back()["parts"] == parts) {
+        spans.back()["end"] = end;
+    } else {
+        spans.push_back({{"start", start}, {"end", end}, {"modality", modality}, {"parts", parts}});
+    }
+}
+
+uint64_t select_bits(const json & value, int count) {
+    if (count < 1 || count > 64) {
+        throw std::invalid_argument("Unsupported layer or query head count");
+    }
+    if (value == "all") {
+        return count == 64 ? UINT64_MAX : (uint64_t{1} << count) - 1;
+    }
+    if (!value.is_array() || value.empty()) {
+        throw std::invalid_argument("Expected all or a nonempty index list");
+    }
+    uint64_t bits = 0;
+    for (const auto & index : value) {
+        const int i = index.get<int>();
+        if (i < 0 || i >= count) {
+            throw std::invalid_argument("Layer or query head index is out of range");
+        }
+        bits |= uint64_t{1} << i;
+    }
+    return bits;
+}
+
+std::vector<llama_attention_span> select_tokens(const json & selector, const json & layout) {
+    const int n = layout.at("token_count").get<int>();
+    const std::string kind = selector.at("kind");
+    if (kind == "all") {
+        return {{0, n}};
+    }
+    if (kind == "range") {
+        const int start = selector.at("start").get<int>(), end = selector.at("end").get<int>();
+        if (start < 0 || end > n || end <= start) {
+            throw std::invalid_argument("Invalid token range for this input layout");
+        }
+        return {{start, end}};
+    }
+
+    std::vector<llama_attention_span> ranges;
+    for (const auto & span : layout.at("spans")) {
+        const auto & parts = span.at("parts");
+        const bool match = kind == "modality" ? span.at("modality") == selector.at("modality") :
+                kind == "part" && std::find(parts.begin(), parts.end(), selector.at("part")) != parts.end();
+        if (match) {
+            const int start = span.at("start").get<int>(), end = span.at("end").get<int>();
+            if (!ranges.empty() && ranges.back().end == start) {
+                ranges.back().end = end;
+            } else {
+                ranges.push_back({start, end});
+            }
+        }
+    }
+    if (ranges.empty()) {
+        throw std::invalid_argument("An attention selector matches no tokens");
+    }
+    return ranges;
+}
+
+} // namespace
+
+server_embedding_input server_embedding_tokenize(const llama_vocab * vocab, mtmd_context * mctx,
+        const mtmd_helper_init_opt & opt, const json & body, int max_tokens) {
+    const auto & parts = body.at("parts");
+    if (!parts.is_array() || parts.empty() || parts.size() > 32) {
+        throw std::invalid_argument("Expected 1–32 input parts");
+    }
+    // The video context outlives the lazy bitmaps and their tokenization.
+    std::vector<mtmd_helper::video_ptr> videos;
+    mtmd::bitmaps bitmaps;
+    std::vector<input_group> groups;
+    json identities = json::array();
+    for (size_t i = 0; i < parts.size(); ++i) {
+        const auto & p = parts[i];
+        const std::string type = p.at("type");
+        if (type == "text") {
+            if (groups.empty() || groups.back().type != "text") {
+                groups.push_back({"text", {}, {}, nullptr});
+            }
+            const std::string text = p.at("text");
+            groups.back().text += text;
+            groups.back().parts.push_back(i);
+            identities.push_back(json::array({"text", text}));
+            continue;
+        }
+        if (!mctx || (type != "image" && type != "audio" && type != "video")) {
+            throw std::invalid_argument("Unsupported media part");
+        }
+        auto bytes = base64_decode(p.at("data").get<std::string>());
+        auto bitmap = mtmd_helper_bitmap_init_from_buf(mctx, bytes.data(), bytes.size(), false, opt);
+        if (bitmap.video_ctx) {
+            videos.emplace_back(bitmap.video_ctx);
+        }
+        if (!bitmap.bitmap) {
+            throw std::invalid_argument("Unable to decode a registered media item");
+        }
+        bitmaps.entries.emplace_back(bitmap.bitmap);
+        groups.push_back({type, {}, {int(i)}, bitmap.bitmap});
+        identities.push_back(json::array({type, p.at("media_id")}));
+    }
+
+    json spans = json::array();
+    json media_positions = json::array();
+    const auto emit_text = [&](const llama_token * tokens, size_t count, size_t offset, const input_group * group) {
+        const std::vector<int> empty;
+        for (size_t i = 0; i < count; ++i) {
+            const bool special = !group || group->type != "text" || control_token(vocab, tokens[i]);
+            add_span(spans, offset + i, offset + i + 1, special ? "control" : "text", group ? group->parts : empty);
+        }
+    };
+
+    server_embedding_input result;
+    if (bitmaps.entries.empty()) {
+        const auto tokens = common_tokenize(vocab, groups.front().text, true, true);
+        for (size_t i = 0; i < tokens.size(); ++i) {
+            const bool added = (i == 0 && llama_vocab_get_add_bos(vocab) && tokens[i] == llama_vocab_bos(vocab)) ||
+                    (i + 1 == tokens.size() && llama_vocab_get_add_eos(vocab) && tokens[i] == llama_vocab_eos(vocab));
+            emit_text(tokens.data() + i, 1, i, added ? nullptr : &groups.front());
+        }
+        result.tokens = server_tokens(tokens, false);
+    } else {
+        std::vector<mtmd_input_text> texts(groups.size());
+        std::vector<mtmd_input_part> input(groups.size());
+        std::vector<const mtmd_input_part *> pointers;
+        for (size_t i = 0; i < groups.size(); ++i) {
+            const auto & group = groups[i];
+            texts[i] = {group.text.data(), group.text.size(), false, true};
+            input[i] = {group.bitmap ? nullptr : &texts[i], group.bitmap};
+            pointers.push_back(&input[i]);
+        }
+
+        mtmd::input_chunks chunks(mtmd_input_chunks_init());
+        if (mtmd_tokenize_with_origins(mctx, chunks.ptr.get(), pointers.data(), pointers.size(), true) != 0) {
+            throw std::invalid_argument("Unable to tokenize the multimodal input");
+        }
+        size_t position = 0;
+        for (size_t i = 0; i < chunks.size(); ++i) {
+            const auto * chunk = chunks[i];
+            const size_t count = mtmd_input_chunk_get_n_tokens(chunk);
+            const int index = mtmd_input_chunk_get_origin(chunk);
+            const auto * group = index < 0 ? nullptr : &groups.at(index);
+            if (mtmd_input_chunk_get_type(chunk) == MTMD_INPUT_CHUNK_TYPE_TEXT) {
+                size_t text_count;
+                const auto * text = mtmd_input_chunk_get_tokens_text(chunk, &text_count);
+                emit_text(text, text_count, position, group);
+            } else {
+                if (!group) {
+                    throw std::runtime_error("Missing source part for a media token");
+                }
+                add_span(spans, position, position + count, group->type, group->parts);
+                media_positions.push_back(json::array({position, count, mtmd_input_chunk_get_n_pos(chunk)}));
+            }
+            position += count;
+        }
+        if (position > size_t(max_tokens)) {
+            throw std::invalid_argument("Input exceeds the model token limit after media expansion");
+        }
+        result.tokens = server_tokens(chunks, true);
+    }
+    if (result.tokens.empty() || result.tokens.size() > size_t(max_tokens) || result.tokens.pos_next() > max_tokens) {
+        throw std::invalid_argument("Input is empty or exceeds the model token limit");
+    }
+    llama_tokens token_ids;
+    token_ids.reserve(result.tokens.size());
+    for (size_t i = 0; i < result.tokens.size(); ++i) {
+        token_ids.push_back(result.tokens[i]);
+    }
+    const auto key = json::array({1, body.at("layout_namespace"), identities, token_ids, spans, media_positions}).dump();
+    result.layout = {{"layout_id", hash_sha256_hex(key.data(), key.size())},
+                     {"token_count", result.tokens.size()}, {"spans", std::move(spans)}};
+    return result;
+}
+
+std::shared_ptr<server_embedding_attention> server_embedding_parse_attention(
+        const json & body, const json & layout, const llama_model * model) {
+    const auto rules = body.value("rules", json::array());
+    const auto probes = body.value("probes", json::array());
+    if (!rules.is_array() || rules.size() > 64 || !probes.is_array() || probes.size() > 16) {
+        throw std::invalid_argument("Attention rule or probe limit exceeded");
+    }
+    const auto supplied = body.value("layout_id", std::string{});
+    if (!supplied.empty() && supplied != layout.at("layout_id").get<std::string>()) {
+        throw std::invalid_argument("layout_id does not match this tokenized input");
+    }
+    if (rules.empty() && probes.empty()) {
+        return nullptr;
+    }
+    auto result = std::make_shared<server_embedding_attention>();
+    result->selections.reserve(rules.size());
+    for (const auto & r : rules) {
+        const auto & q = r.at("query");
+        const auto & k = r.at("key");
+        if (supplied.empty() && (q.at("kind") == "range" || k.at("kind") == "range")) {
+            throw std::invalid_argument("A layout_id is required for raw token ranges");
+        }
+        const std::string action = r.at("action");
+        if (action != "allow" && action != "block") {
+            throw std::invalid_argument("Attention action must be allow or block");
+        }
+        auto & selection = result->selections.emplace_back(
+                server_embedding_attention::selection{select_tokens(q, layout), select_tokens(k, layout)});
+        result->rules.push_back({select_bits(r.at("layers"), llama_model_n_layer(model)),
+                                 select_bits(r.at("heads"), llama_model_n_head(model)),
+                                 selection.queries.data(), selection.queries.size(),
+                                 selection.keys.data(), selection.keys.size(), action == "allow"});
+    }
+    for (const auto & p : probes) {
+        result->probes.push_back({p.at("layer").get<int>(), p.at("head").get<int>(), p.at("query").get<int>(), p.at("key").get<int>(), false, false, 0});
+    }
+    return result;
+}
+
+json server_embedding_probes(const server_embedding_attention & attention) {
+    json probes = json::array();
+    for (const auto & p : attention.probes) {
+        if (!p.observed || !std::isfinite(p.probability)) {
+            throw std::runtime_error("Attention probe was not observed");
+        }
+        probes.push_back({{"layer", p.layer}, {"head", p.head}, {"query", p.query}, {"key", p.key},
+                          {"allowed", p.allowed}, {"probability", p.probability}});
+    }
+    return probes;
+}
