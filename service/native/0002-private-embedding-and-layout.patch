+std::unique_ptr<server_res_generator> server_routes::handle_local_embedding(const server_http_req & req, bool layout_only) {
+    auto res = create_response();
+    if (!params.embedding || params.n_parallel != 1 || meta->pooling_type == LLAMA_POOLING_TYPE_NONE) {
+        throw std::invalid_argument("This endpoint requires one pooled embedding slot");
+    }
+    const auto body = json::parse(req.body);
+    const int limit = std::min({meta->slot_n_ctx, int(params.n_ubatch), body.at("max_tokens").get<int>()});
+    auto input = server_embedding_tokenize(ctx_server.vocab, ctx_server.mctx, ctx_server.init_opt, body, limit);
+    if (layout_only) {
+        res->ok(input.layout);
+        return res;
+    }
+
+    auto attention = server_embedding_parse_attention(body, input.layout, ctx_server.model_tgt);
+    auto & rd = res->rd;
+    server_task task(SERVER_TASK_TYPE_EMBEDDING);
+    task.id = rd.get_new_id();
+    task.tokens = std::move(input.tokens);
+    task.local_embedding = true;
+    task.attention = attention;
+    task.params.embd_normalize = params.embd_normalize;
+    std::vector<server_task> tasks;
+    tasks.push_back(std::move(task));
+    rd.post_tasks(std::move(tasks));
+
+    auto completed = rd.wait_for_all(req.should_stop);
+    if (completed.is_terminated) {
+        return res;
+    }
+    if (completed.error) {
+        res->error(completed.error->to_json());
+        return res;
+    }
+    const auto & embedding = dynamic_cast<const server_task_result_embd &>(*completed.results.at(0));
+    auto & out = input.layout;
+    out["embedding"] = embedding.embedding.at(0);
+    out["engine_version"] = llama_version();
+    if (attention && !attention->probes.empty()) {
+        out["probes"] = server_embedding_probes(*attention);
+    }
+    res->ok(out);
+    return res;
+}
