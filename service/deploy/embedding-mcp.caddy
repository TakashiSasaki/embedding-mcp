embedding-mcp.moukaeritai.work {
	log embedding_mcp {
		output file /home/ubuntu/caddy/logs/embedding-mcp-access.log {
			mode 0600
			roll_size 2MiB
			roll_keep 2
			roll_keep_for 72h
		}
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri regexp "[?].*$" ""
				resp_headers delete
			}
		}
	}
	@trusted_mcp {
		path /mcp
		# Gemini POSTs use the Google fetcher range. The narrower /29 covers the observed HEAD and GET probes.
		client_ip {args[:]} 66.249.82.128/27 108.177.69.32/29
	}
	handle @trusted_mcp {
		reverse_proxy 127.0.0.1:18765 {
			flush_interval -1
			header_up Host {upstream_hostport}
		}
	}
	handle /mcp {
		respond 403
	}
	@landing {
		method GET HEAD
		path / /landing.css /landing.js /favicon.svg
	}
	handle @landing {
		root * /data/cpu-embedding-experiments/main/service/web
		header {
			Cache-Control no-cache
			Content-Security-Policy "default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			Referrer-Policy no-referrer
			X-Content-Type-Options nosniff
		}
		file_server
	}
	handle {
		respond 404
	}
}
