embedding-mcp.moukaeritai.work {
	log embedding_mcp {
		output file /home/ubuntu/caddy/logs/embedding-mcp-access.log {
			mode 0600
			roll_size 2MiB
			roll_keep 2
			roll_keep_for 72h
		}
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri regexp "[?].*$" ""
				resp_headers delete
			}
		}
	}
	# RFC 8414 / SEP-233 OAuth probe: respond 404 immediately so clients know no OAuth is needed
	handle /.well-known/oauth-protected-resource* {
		respond "Not Found" 404
	}

	# Preflight HEAD requests on MCP endpoint: respond 200 immediately
	@mcp_head {
		path /mcp*
		method HEAD
	}
	handle @mcp_head {
		header Content-Type "application/json"
		respond 200
	}

	@trusted_mcp {
		path /mcp /mcp/*
		client_ip {args[:]} 66.249.64.0/19 66.102.0.0/20 64.233.160.0/19 72.14.192.0/18 209.85.128.0/17 108.177.0.0/17 172.217.0.0/16 142.250.0.0/15 192.178.0.0/15 74.125.0.0/16 173.194.0.0/16 216.239.32.0/19 216.58.192.0/19
	}
	handle @trusted_mcp {
		reverse_proxy 127.0.0.1:18765 {
			flush_interval -1
			header_up Host {upstream_hostport}
		}
	}
	handle /mcp {
		respond 403
	}
	@landing {
		method GET HEAD
		path / /landing.css /landing.js /favicon.svg
	}
	handle @landing {
		root * /data/cpu-embedding-experiments/main/service/web
		header {
			Cache-Control no-cache
			Content-Security-Policy "default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			Referrer-Policy no-referrer
			X-Content-Type-Options nosniff
		}
		file_server
	}
	handle {
		respond 404
	}
}
